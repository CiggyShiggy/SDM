					<m_strEventCode>$sql = CustomQuery("SELECT nama_panggilan, id_pegawai FROM kmu_sdm.m_pegawai WHERE nama_panggilan = '".$_SESSION['UserID']."'");
$out = db_fetch_array($sql);
$values['id_pegawai'] = $out['id_pegawai'];
$values['entry_user'] = $out['nama_panggilan'];

