$ambildata = db_fetch_array($sql);
$update = CustomQuery("UPDATE absensi.t_lembur_pegawai SET menit_lembur = '".$ambildata['menit']."' WHERE entry_date = '".$values['entry_date']."' AND id_pegawai = '".$values['id_pegawai']."' AND nama_panggilan = '". $_SESSION['UserID']."'");


