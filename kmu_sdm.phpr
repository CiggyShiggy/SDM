t_cuti_pegawai.entry_user,
sisa_cuti.sisa_ct,
YEAR(t_cuti_pegawai.tgl_mulai)
FROM sisa_cuti
LEFT OUTER JOIN t_cuti_pegawai ON sisa_cuti.id_pegawai = t_cuti_pegawai.id_pegawai
WHERE (t_cuti_pegawai.entry_user = ':session.UserID')
