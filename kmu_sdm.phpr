						<m_strEventCode>//id cabang otomatis
	$rs = CustomQuery("SELECT MAX(CAST(id AS INT)) AS id FROM m_cabang");
	$record = db_fetch_array($rs);
	$values['id'] = sprintf('%02d',intval($record['id']) + 1);

// Place event code here.
