				<query>
					<m_sql>SELECT
	id_pegawai,
	nama_pegawai,
	tgl_lahir,
	jns_kel,
	agama,
	alamat,
	no_telp,
	email,
	no_ktp,
	tgl_masuk,
	pendidikan,
	prodi,
	status_pgw,
	penempatan,
	id_unit,
	nm_unit,
	foto,
	file_ktp,
	password,
	aktif
