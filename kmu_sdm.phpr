}
else if($values['lock_hrd']=='1'&amp;&amp; $values['kode_jc']=='CL'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_hrd ='1', statuss = 'Permohonan Cuti Lain di setujui oleh HRD maupun Kep.Div/Manager' WHERE kode_jc='CT' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='0'&amp;&amp; $values['kode_jc']=='S'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_hrd ='0', statuss = 'Permohonan Cuti Sakit di tolak oleh HRD' WHERE kode_jc='S' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='0'&amp;&amp; $values['kode_jc']=='I'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_hrd ='0', statuss = 'Permohonan Izin cuti di tolak oleh HRD' WHERE kode_jc='I' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='0'&amp;&amp; $values['kode_jc']=='CT'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_hrd ='0', statuss = 'Permohonan Cuti Tahunan di tolak oleh HRD' WHERE kode_jc='CT' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='0'&amp;&amp; $values['kode_jc']=='CL'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_hrd ='0', statuss = 'Permohonan Cuti Lain di tolak oleh HRD' WHERE kode_jc='CL' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}





