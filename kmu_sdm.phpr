					<m_strOrderField>CONCAT(TIMESTAMPDIFF( YEAR, NOW(), tgl_akhir ), ' Tahun ', TIMESTAMPDIFF( MONTH, NOW(), tgl_akhir ) % 12, ' Bulan ', FLOOR( TIMESTAMPDIFF( DAY, NOW(), tgl_akhir) % 30.4375 ), ' Hari')</m_strOrderField>
				</v>
			</m_arrOrderIndexes>
			<m_strSQL>SELECT
no_surat,
perihal,
perusahaan_1,
perusahaan_2,
tgl_awal,
tgl_akhir,
CONCAT(TIMESTAMPDIFF( YEAR, NOW(), tgl_akhir ),' Tahun ',
TIMESTAMPDIFF( MONTH, NOW(), tgl_akhir ) % 12,' Bulan ',
FLOOR( TIMESTAMPDIFF( DAY, NOW(), tgl_akhir) % 30.4375 ),' Hari') AS kurang,
DATEDIFF(tgl_akhir,NOW()) as hari
FROM t_mou_vendor
WHERE (DATEDIFF(tgl_akhir,NOW()) &lt;= 60) and (DATEDIFF(tgl_akhir,NOW()) &gt;= -15)
ORDER BY kurang DESC
</m_strSQL>
			<m_sqlHead>SELECT no_surat,
perihal,
perusahaan_1,
perusahaan_2,
