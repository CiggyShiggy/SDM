					<m_strPage>List page</m_strPage>
					<m_strName>EVENT_BEFOREPROCESS_LIST</m_strName>
					<m_strEventCode>$rs = DB::Query("SELECT a.id_pegawai,a.nama_panggilan ".
								 "FROM absensi.t_lembur_pegawai a ".
								 "WHERE approve_user = '".Security::getUserName()."' ".
								 "GROUP BY a.id_pegawai");
while( $record = $rs-&gt;fetchAssoc() )
{
$where = "id_pegawai='".$record['id_pegawai']."'";
$title = $record['nama_panggilan'];
$id = "Lembur".$record['id_pegawai'];
$pageObject-&gt;addTab($where, $title, $id);
};

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
					<m_strEventID>EVENT_BEFOREPROCESS_LIST</m_strEventID>
