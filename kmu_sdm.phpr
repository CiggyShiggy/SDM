			<m_strEventCode>
// note: text field values need to be wrapped by single quotes
//Logging Login
$sql = "INSERT INTO kmu_sdm.st_login (login_datetime, userid, ip, akses) values (";
$sql .= "'".now()."',";
$sql .= "'".$username."',";
$sql .= "'".$_SERVER['REMOTE_ADDR']."',";
$sql .= "'KMU_SDM'";
$sql .= ")";
DB::Query($sql);


