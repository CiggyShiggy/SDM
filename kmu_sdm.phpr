					<m_strName>EVENT_AFTERADD</m_strName>
					<m_strEventCode>$values['alasan'];
$values['date_token'];
$values['entry_user'];
$values['kode_jc'];
$values['entry_date'];


$sql = CustomQuery("SELECT tgl_mulai, tgl_selesai FROM absensi.t_cuti_bersama ORDER BY id_pegawai DESC LIMIT 1");
$getdate = db_fetch_array($sql);

$sqli = CustomQuery("SELECT DATEDIFF(tgl_selesai,tgl_mulai) as ambil FROM absensi.t_cuti_bersama ORDER BY id_pegawai DESC LIMIT 1");
$getrec = db_fetch_array($sqli);
$getrec['ambil'] = 1+ $getrec['ambil'];

$sqli = CustomQuery("SELECT DATEDIFF(tgl_selesai,tgl_mulai) as hakcuti FROM absensi.t_cuti_bersama ORDER BY id_pegawai DESC LIMIT 1");
$getreci = db_fetch_array($sqli);

$kue = CustomQuery("SELECT b.jumlah FROM absensi.`t_cuti_pegawai` c LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah FROM absensi.cuti_detail k 
WHERE YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai");
$cekdata = db_fetch_array($kue);

$getreci['hakcuti']=(12-$cekdata['jumlah'])-(1 + $getreci['hakcuti']);

$sql1 = CustomQuery("INSERT INTO absensi.t_cuti_pegawai(id_pegawai, tgl_mulai, tgl_selesai, kode_jc,alasan, approve_datehr, lock_hrd, approve_hrd, approve_datemgr, lock_mngr,entry_user,statuss,entry_date,hak_cuti,cuti_dipakai,date_token)
											SELECT p.id_pegawai,'".$getdate['tgl_mulai']."','".$getdate['tgl_selesai']."','".$values['kode_jc']."','".$values['alasan']."','".$getdate['tgl_mulai']."','1','".$values['entry_user']."','".$getdate['tgl_mulai']."','1',p.nama_panggilan,'Permohonan Cuti Tahunan telah di setujui oleh HRD maupun Kep.Div/Manager',
'".$values['entry_date']."','".$getreci['hakcuti']."','".$getrec['ambil']."','".$values['date_token']."'FROM kmu_sdm.m_pegawai p WHERE p.aktif = 'Y'");


$begin = new DateTime( $values['tgl_mulai'] );
$end   = new DateTime( $values['tgl_selesai'] );

for($i = $begin; $i &lt;= $end; $i-&gt;modify('+1 day')){
    $tampung = $i-&gt;format("Y-m-d");
    $in = CustomQuery("INSERT INTO absensi.cuti_detail(`id_pegawai`,  `tgl`, `entry_user`, kode_jc,`entry_date`, date_token, data_add) 
												SELECT p.id_pegawai,'".$tampung."',p.nama_panggilan,'".$values['kode_jc']."','".$values['entry_date']."','".$values['date_token']."','0' 
												FROM kmu_sdm.m_pegawai p WHERE p.aktif = 'Y'");
}

$cek = CustomQuery("SELECT c.id_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah  FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai");
$kue = db_fetch_array($cek);
$skil = CustomQuery("SELECT id_pegawai,sisa_ct FROM absensi.sisa_cuti");
$kuwe = db_fetch_array($skil);
if(!empty($kuwe['id_pegawai']) || !empty($kuwe['sisa_ct'])){
	$sqli = CustomQuery("DELETE FROM absensi.sisa_cuti WHERE id_pegawai IS NOT NULL");

	$sqlis = CustomQuery("INSERT INTO absensi.sisa_cuti(`id_pegawai`, `sisa_ct`) 
												SELECT c.id_pegawai, c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai");

}else{
	$sqli = CustomQuery("INSERT INTO absensi.sisa_cuti(`id_pegawai`, `sisa_ct`) 
												SELECT c.id_pegawai, c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai");
}

