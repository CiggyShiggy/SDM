			<m_arrOrderIndexes />
			<m_strSQL>SELECT
id_pegawai,
nama_panggilan,
nama_pegawai,
25 AS nilai_max,
CASE WHEN NULLIF(id_pegawai,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(nama_panggilan,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(nama_pegawai,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(jns_kel,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(tgl_lahir,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(agama,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(alamat,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(no_telp,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(email,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(no_ktp,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(tgl_masuk,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(pendidikan,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(prodi,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(status_pgw,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(kategori,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(id_cabang,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(cabang,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(id_unit,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(nm_unit,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(foto,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(file_ktp,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(sandi,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(keterangan,'') IS NULL THEN 0 ELSE 1 END +
	CASE WHEN NULLIF(aktif,'') IS NULL THEN 0 ELSE 1 END AS nilai
FROM m_pegawai
WHERE (nama_panggilan &lt;&gt; 'administrator') AND (aktif = "Y")
</m_strSQL>
