			<m_strSQL>SELECT
id_pegawai,
tgl,
jam_mulai,
jam_selesai,
ket,
status,
catatan,
menit_lembur,
seq,
jam_mulai_real,
jam_akhir_real,
entry_date,
nama_panggilan,
mac_computer,
