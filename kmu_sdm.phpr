			<m_strSQL>SELECT
id_pegawai,
nama_panggilan,
nama_pegawai,
jns_kel,
tgl_lahir,
agama,
alamat,
no_telp,
email,
no_rek,
no_ktp,
tgl_masuk,
pendidikan,
prodi,
status_pgw,
kategori,
id_cabang,
id_unit,
pangkat,
foto,
file_ktp,
sandi,
keterangan,
isdokter,
aktif,
cabang,
nm_unit,
jabatan,
is_bpjs,
is_bpjstk,
is_npwp,
npwp,
m_status_ptkp
FROM m_pegawai
WHERE (aktif = 'Y')
</m_strSQL>
