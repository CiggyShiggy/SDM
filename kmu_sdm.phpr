					<m_strEventCode>//NIP otomatis
$tanggal = date('Y.m.d',strtotime($values['tgl_masuk']));

if($values['jns_kel']=='L')
{$jns = '01';}
else
{$jns = '02';};

$rs = CustomQuery("SELECT MAX(CAST(RIGHT(id_pegawai,3) AS INT)) AS id_pegawai FROM m_pegawai");
$record = db_fetch_array($rs);
$nilai = sprintf('%03d',intval($record['id_pegawai']) + 1);

$values['id_pegawai'] = $tanggal.'.'.$jns.'.'.$nilai;

$message = 'NIP = '.$values['id_pegawai'];


// Place event code here.
// Use "Add Action" button to add code snippets.

return true;</m_strEventCode>
