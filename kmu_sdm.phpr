YEAR(CURDATE()) - YEAR(tgl_masuk) - IF(STR_TO_DATE(CONCAT(YEAR(CURDATE()), '-', MONTH(tgl_masuk), '-', DAY(tgl_masuk)) ,'%Y-%c-%e') &gt; CURDATE(), 1, 0) AS masa_kerja</m_sqlHead>
