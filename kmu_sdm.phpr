					<m_strEventCode>$values['entry_date']=now();
$que = CustomQuery("SELECT uuid()");
$tampungan = db_fetch_array($que);
$values['date_token'] = $tampungan['uuid()'];
$id_pegawai = $values['id_pegawai'];
$tgl_mulai = $values['tgl_mulai'];
$tgl_selesai = $values['tgl_selesai'];

$cek = CustomQuery("SELECT k.`id_pegawai` 
											FROM absensi.`t_cuti_bersama` k 
											INNER JOIN absensi.`cuti_detail` c ON k.`id_pegawai` = c.`id_pegawai` 
											WHERE k.id_pegawai = '".$id_pegawai."' 
											AND c.tgl between  '".$tgl_mulai."' AND '".$tgl_selesai."' ");
$res = db_fetch_array($cek);
if($res['id_pegawai']!=""){
$message = "Tanggal Tersebut Telah Anda Diambil";
return false;
exit();
}
// Place event code here.
// Use "Add Action" button to add code snippets.

return true;</m_strEventCode>
					<m_strEventID>EVENT_BEFOREADD</m_strEventID>
