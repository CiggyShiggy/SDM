					<m_strEventCode>$rs = CustomQuery("SELECT a.`id_pegawai`,a.`nama_panggilan`,a.`nama_pegawai` FROM m_pegawai a WHERE a.`nama_panggilan`='".$_SESSION['UserID']."'");
$record = db_fetch_array($rs);
//===============Default value====================================
$values['id_pegawai'] = $record['id_pegawai'];
$values['nama_pegawai'] = $record['nama_pegawai'];
//===============Entry ID========================================
$values['entry_date'] = now();
$values['id_entry'] = $record['id_pegawai'];

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
