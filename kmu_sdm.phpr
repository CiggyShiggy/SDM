				<m_arrOrderIndexes />
				<m_strSQL>SELECT
up.id_pegawai,
p.nama_pegawai,
up.cuti_jatah,
c.sisa_ct
FROM kmu_sdm.m_pegawai AS p
LEFT OUTER JOIN kmu_sdm.m_userinfo_pegawai AS up ON p.id_pegawai = up.id_pegawai
LEFT OUTER JOIN sisa_cuti AS c ON up.id_pegawai = c.id_pegawai
WHERE (up.id_pegawai = p.id_pegawai) AND p.aktif = 'Y'
</m_strSQL>
				<m_sqlHead>SELECT up.id_pegawai,
p.nama_pegawai,
up.cuti_jatah,
c.sisa_ct</m_sqlHead>
				<m_sqlFrom>FROM kmu_sdm.m_pegawai AS p
LEFT OUTER JOIN kmu_sdm.m_userinfo_pegawai AS up ON p.id_pegawai = up.id_pegawai
LEFT OUTER JOIN sisa_cuti AS c ON up.id_pegawai = c.id_pegawai</m_sqlFrom>
				<m_sqlWhere>(up.id_pegawai = p.id_pegawai) AND p.aktif = 'Y'</m_sqlWhere>
