	nm_pegawai,
	tgl_awal,
	tgl_akhir,
	no_surat,
	index_berkas,
	kat_id,
	kategori,
	tujuan,
	alamat,
	pengirim,
	perihal,
	lampiran,
	file_scan,
	keterangan
FROM t_surat_keluar
WHERE tgl_akhir BETWEEN now() and DATE_ADD(now(),INTERVAL 7 DAY)</m_strSQL>
