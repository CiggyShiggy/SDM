			<query>
				<m_sql>SELECT
l.id_pegawai,
l.nama_panggilan,
l.id_manager
FROM m_pegawai AS p
LEFT OUTER JOIN t_level_pegawai AS l ON p.id_pegawai = l.id_manager
WHERE (p.nama_panggilan = ':session.UserID')
</m_sql>
