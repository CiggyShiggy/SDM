			<m_strSQL>SELECT
	id_pegawai,
	tgl_mulai,
	tgl_selesai,
	kode_jc,
	alasan,
	totalhari,
	approve_datehr,
	lock_hrd,
	approve_hrd,
	approve_datemgr,
	lock_mngr,
	approve_mngr,
	seq,
	entry_user,
	statuss,
	entry_date,
	hak_cuti,
	cuti_dipakai,
	catatan,
	approve_mac_komputer,
	date_token,
	data_add,
	surat_sakit,
	nama_cabang
FROM t_cuti_pegawai ORDER BY tgl_mulai DESC</m_strSQL>
