					<m_strPage>Add page</m_strPage>
					<m_strName>EVENT_PROCESSVALUES_ADD</m_strName>
					<m_strEventCode>$rs = CustomQuery("SELECT * FROM m_pegawai WHERE nama_panggilan = '".$_SESSION['UserID']."'");
$record = db_fetch_array($rs);
$values['id_pegawai'] = $record['id_pegawai'];
$values['nama_panggilan'] = $_SESSION['UserID'];

$a = CustomQuery(" SELECT p.nama_panggilan FROM t_level_pegawai l LEFT JOIN m_pegawai p ON  p.id_pegawai = l.id_manager WHERE l.nama_panggilan= '".$_SESSION['UserID']."'");
$record = db_fetch_array($a);
$values['approve_user'] = $record['nama_panggilan'];

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
