					<m_strName>EVENT_PROCESSVALUES_ADD</m_strName>
					<m_strEventCode>date_default_timezone_set('Asia/Jakarta');
$rs = CustomQuery("SELECT a.`id_pegawai`,a.`nama_panggilan`,a.`nama_pegawai`,a.`id_unit`,a.`nm_unit`,b.`id_manajer`,b.`nm_manajer` FROM m_pegawai a LEFT JOIN m_unit_kerja b ON a.`id_unit`=b.`id_unit` WHERE a.`nama_panggilan`='".$_SESSION['UserID']."'");
$record = db_fetch_array($rs);
$values['id_pegawai'] = $record['id_pegawai'];
$values['id_unit'] = $record['id_unit'];
$values['id_manajer'] = $record['id_manajer'];

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
