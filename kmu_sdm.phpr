					<m_strPage>Edit page</m_strPage>
					<m_strName>EVENT_AFTEREDIT</m_strName>
					<m_strEventCode>$sql = CustomQuery("SELECT tgl, TIMESTAMPDIFF(MINUTE,jam_mulai_real,jam_akhir_real) as menit FROM absensi.t_lembur_pegawai WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."' AND entry_date = '".$values['entry_date']."'");
$ambildata = db_fetch_array($sql);
$update = CustomQuery("UPDATE absensi.t_lembur_pegawai SET menit_lembur = '".$ambildata['menit']."' WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."' AND entry_date = '".$values['entry_date']."'");


$cek = CustomQuery("SELECT status FROM absensi.t_lembur_pegawai where id_pegawai = '".$values['id_pegawai']."'AND tgl= '".$values['tgl']."' AND jam_mulai = '".$values['jam_mulai']."' AND entry_date = '".$values['entry_date']."'");
$rec = db_fetch_array($cek);

if($rec['status'] == 'DILAKSANAKAN'){
$upket = CustomQuery("UPDATE absensi.t_lembur_pegawai SET keterangans = 'Permohonan lembur oleh Kep.Div/Manager dilaksanakan oleh Pegawai,menunggu persetujuan menunggu Kep.Div/Manager dan persetujuan HRD' WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."' AND entry_date = '".$values['entry_date']."'");

}
else if($rec['status'] == 'DITOLAK'){
$upket = CustomQuery("UPDATE absensi.t_lembur_pegawai SET keterangans = 'Permohonan lembur oleh Kep.Div/Manager ditolak oleh Pegawai' WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."' AND entry_date = '".$values['entry_date']."'");

}
