					<m_strEventCode>//id otomatis
$rs = CustomQuery("SELECT MAX(id_kalender_kerja) AS id FROM t_kalender_kerja");
$record = db_fetch_array($rs);
$values['id_kalender_kerja'] = $record['id'] + 1;
//entry otomatis
$rs = CustomQuery("SELECT id_pegawai FROM m_pegawai WHERE `nama_panggilan`='".$_SESSION['UserID']."'");
$record = db_fetch_array($rs);
if (empty($record['id_pegawai'])){
$values['updated_by'] = $_SESSION['UserID'];
}else{
$values['updated_by'] = $record['id_pegawai'];
}

