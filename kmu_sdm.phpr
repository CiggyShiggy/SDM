						<m_strName>EVENT_PROCESSVALUES_ADD</m_strName>
						<m_strEventCode>$sql1 = CustomQuery("SELECT p.id_pegawai, a.`nama_panggilan` FROM kmu_sdm.m_userinfo_pegawai p,kmu_sdm.m_pegawai a WHERE p.id_pegawai=a.id_pegawai AND a.nama_panggilan ='".$_SESSION['UserID']."' ");
$record = db_fetch_array($sql1);
$values['id_pegawai']=$record['id_pegawai'];
$values['entry_user']=$record['nama_panggilan'];
//$sql11 = CustomQuery("SELECT a.hak_cuti FROM absensi.t_cuti_pegawai a WHERE a.id_pegawai ='".$values['id_pegawai']."' AND a.entry_user ='".$_SESSION['UserID']."' ORDER BY a.tgl_mulai DESC LIMIT 1 ");
//$record1 = db_fetch_array($sql11);
$sql = CustomQuery("SELECT COUNT(d.id_pegawai) AS totalambil FROM absensi.`t_cuti_pegawai` p 
									LEFT JOIN absensi.`cuti_detail` d ON p.date_token = d.date_token 
									WHERE d.id_pegawai =  '".$values['id_pegawai']."' 
									AND p.lock_hrd = '1' AND p.lock_mngr ='1'
										AND d.kode_jc = 'CT'
										AND YEAR(d.tgl)= YEAR(NOW())GROUP BY d.id_pegawai");
$tampung = db_fetch_array($sql);
$lokasi = CustomQuery("SELECT c.`kode` FROM kmu_sdm.m_pegawai p LEFT JOIN kmu_sdm.m_cabang c ON p.`id_cabang` = c.`id` WHERE p.nama_panggilan ='".$values['entry_user']."'");
$rec = db_fetch_array($lokasi);
$values['nama_cabang'] = $rec['kode'];
$sql2 = CustomQuery("SELECT p.`nama_panggilan` FROM `t_level_pegawai` l LEFT JOIN m_pegawai p ON l.`id_manager` = p.`id_pegawai` WHERE l.`id_pegawai` = '".$values['id_pegawai']."'");
$record1 = db_fetch_array($sql2);
$values['approve_mngr'] = $record1['nama_panggilan'];

//$hak = CustomQuery("SELECT p.cuti_jatah FROM kmu_sdm.m_userinfo_pegawai p WHERE p.id_pegawai = '".$values['id_pegawai']."'");
//$rec = db_fetch_array($sql);
$values['hak_cuti']= 12 - $tampung['totalambil'];






