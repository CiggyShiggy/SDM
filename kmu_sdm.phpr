			<query>
				<m_sql>SELECT
k.id_manajer,
p.nama_pegawai,
p.id_unit,
k.nm_unit
FROM m_pegawai AS p
RIGHT OUTER JOIN m_unit_kerja AS k ON k.id_manajer = p.id_pegawai
WHERE (IFNULL(k.isaktif, 0) =1) AND (p.nama_panggilan = ':session.UserID') AND (p.aktif = 'Y')
