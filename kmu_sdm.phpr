			<m_queryContext />
			<query>
				<m_sql>SELECT
	id,
	tgl_pindah_shf,
	id_pegawai,
	cabang,
	shift,
	jam_shift,
	nama_panggilan,
	keterangan,
	status_approve,
	approve_date,
	approve_user,
	entry_date
FROM t_ajuan_shift where approve_user = ':session.UserID' order by id desc</m_sql>
				<m_parsed>1</m_parsed>
				<type>SQL::Query</type>
				<m_strHead>SELECT</m_strHead>
				<m_strFieldList>id,
	tgl_pindah_shf,
	id_pegawai,
	cabang,
	shift,
	jam_shift,
	nama_panggilan,
	keterangan,
	status_approve,
	approve_date,
	approve_user,
	entry_date</m_strFieldList>
				<m_strFrom>FROM t_ajuan_shift</m_strFrom>
				<m_strWhere>approve_user = ':session.UserID'</m_strWhere>
				<m_strOrderBy>order by id desc</m_strOrderBy>
				<m_strTail></m_strTail>
				<m_where>
					<m_sql>approve_user = ':session.UserID'</m_sql>
