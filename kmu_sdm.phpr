					<m_strEventCode>$cek = CustomQuery("SELECT approve_spv FROM absensi.t_lembur_pegawai where id_pegawai = '".$values['id_pegawai']."'AND tgl= '".$values['tgl']."' AND jam_mulai = '".$values['jam_mulai']."'");
$rec = db_fetch_array($cek);

if($rec['approve_spv'] == 'DISETUJUI'){
$upket = CustomQuery("UPDATE absensi.t_lembur_pegawai SET keterangans = 'Permohonan lembur Disetujui oleh Kep.Div/Manager dan menunggu persetujuan HRD' WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."'");

}
else if($rec['approve_spv'] == 'DITOLAK'){
$upket = CustomQuery("UPDATE absensi.t_lembur_pegawai SET keterangans = 'Permohonan lembur  ditolak oleh oleh Kep.Div/Manager' WHERE id_pegawai = '".$values['id_pegawai']."' AND tgl= '".$values['tgl']."'AND jam_mulai = '".$values['jam_mulai']."'");
