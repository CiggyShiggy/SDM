			<query>
				<m_sql>SELECT
id_pegawai,
nama_pegawai,
tgl_lahir,
tgl_masuk,
YEAR(CURDATE()) - YEAR(tgl_lahir) AS usia,
YEAR(CURDATE()) - YEAR(tgl_masuk) AS masa_kerja
FROM m_pegawai
WHERE (nama_panggilan &lt;&gt; 'administrator') AND (aktif = "Y")
</m_sql>
