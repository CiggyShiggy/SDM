						<m_strEventCode>date_default_timezone_set('Asia/Jakarta');
$values['entry_date']=now();
$values['lock_hrd']='0';
$values['lock_mngr']='0';
$tgl_mulai=$values['tgl_mulai'];
$tgl_selesai  = $values['tgl_selesai'];
$id_pegawai = $values['id_pegawai'];
$nama_user = $values['entry_user'];

$sql = CustomQuery("SELECT COUNT(d.id_pegawai) AS totalambil FROM absensi.`t_cuti_pegawai` p 
									LEFT JOIN absensi.`cuti_detail` d ON p.date_token = d.date_token 
									WHERE d.id_pegawai =  '".$values['id_pegawai']."' 
									AND p.lock_hrd = '1' AND p.lock_mngr ='1'
										AND d.kode_jc = 'CT'
										AND YEAR(d.tgl)= YEAR(NOW())GROUP BY d.id_pegawai");
$tampung = db_fetch_array($sql);
$values['hak_cuti']= 12 - $tampung['totalambil'];

$kueri = date_diff($values['tgl_mulai'],$values['tgl_selesai']) ;
$result=db_fetch_array($kueri);

$masakerja = CustomQuery("SELECT ((YEAR(CURDATE())-YEAR(p.tgl_masuk))-(RIGHT(CURDATE(),5) &lt; RIGHT(p.tgl_masuk,5))) AS masakerja, p.id_pegawai, p.nama_pegawai,p.nama_panggilan FROM kmu_sdm.`m_pegawai` p WHERE p.id_pegawai = '".$id_pegawai."' AND p.nama_panggilan = '".$_SESSION['UserID']."'");
$rest = db_fetch_array($masakerja);

if($rest['masakerja'] == '0' &amp;&amp; $values['kode_jc']=='CT'){
$kue = CustomQuery("UPDATE kmu_sdm.m_userinfo_pegawai SET cuti_jatah = '0' WHERE id_pegawai = '".$values['id_pegawai']."'");
$message = "Masa Kerja Anda Di Bawah 1 Tahun, Mohon Maaf Anda Tidak Boleh Cuti Tahunan";
return false;
exit();
}
else if ($rest['masakerja'] &gt; '0' ){
$kue = CustomQuery("UPDATE kmu_sdm.m_userinfo_pegawai SET cuti_jatah = '12' WHERE id_pegawai = '".$values['id_pegawai']."'");
}
//else if ($rest['masakerja'] &gt; '5' ){
//$kue = CustomQuery("UPDATE kmu_sdm.m_userinfo_pegawai SET cuti_jatah = '15' WHERE id_pegawai = '".$values['id_pegawai']."'");
//}

//$cekjatah = CustomQuery("SELECT sisa_ct FROM absensi.sisa_cuti WHERE id_pegawai = '".$values['id_pegawai']."'");
//$tampils = db_fetch_array($cekjatah);

//$values['hak_cuti'] = $tampils['sisa_ct'];

if($values['hak_cuti'] == '0'){
$message = "Maaf Jatah Cuti Tahunan Anda Telah Habis";
return false;
exit();
}

$cek = CustomQuery("SELECT k.`id_pegawai` 
											FROM absensi.`t_cuti_pegawai` k 
											INNER JOIN absensi.`cuti_detail` c ON k.`id_pegawai` = c.`id_pegawai` 
											WHERE k.id_pegawai = '".$id_pegawai."' 
											AND c.tgl between  '".$tgl_mulai."' AND '".$tgl_selesai."' 
											AND k.lock_mngr = '1' AND k.lock_hrd = '1'");
$res = db_fetch_array($cek);
if($res['id_pegawai']!=""){
$message = "Tanggal Tersebut Telah Anda Diambil";
return false;
exit();
}





//$rs = DB::Query("SELECT DATEDIFF(t.tgl_selesai,t.tgl_mulai) AS total FROM absensi.t_cuti_pegawai t WHERE t.`nama_panggilan` = '".$_SESSION['UserID']."'");
