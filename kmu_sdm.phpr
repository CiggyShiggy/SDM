			<query>
				<m_sql>SELECT DISTINCT
c.cabang,
  a.kode
FROM
  kmu_sdm.t_waktu_shift a
  LEFT JOIN kmu_sdm.m_cabang c
    ON a.kode = c.kode
  LEFT JOIN kmu_sdm.m_pegawai p
    ON p.id_cabang = c.id WHERE p.nama_panggilan = ':session.UserID'</m_sql>
