			<m_queryContext />
			<query>
				<m_sql>SELECT c.id_pegawai,p.nama_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah  FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE k.kode_jc = 'CT' AND YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai
LEFT JOIN kmu_sdm.m_pegawai p ON p.id_pegawai = c.id_pegawai WHERE p.aktif = 'Y'
	</m_sql>
				<m_parsed>1</m_parsed>
				<type>SQL::Query</type>
				<m_strHead>SELECT</m_strHead>
				<m_strFieldList>c.id_pegawai,p.nama_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah</m_strFieldList>
				<m_strFrom>FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE k.kode_jc = 'CT' AND YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai
LEFT JOIN kmu_sdm.m_pegawai p ON p.id_pegawai = c.id_pegawai</m_strFrom>
				<m_strWhere>p.aktif = 'Y'</m_strWhere>
				<m_strOrderBy></m_strOrderBy>
				<m_strTail></m_strTail>
				<m_where>
					<m_sql>p.aktif = 'Y'</m_sql>
