			<m_strSQL>SELECT
id_pegawai,
tgl,
jam_mulai,
jam_selesai,
ket,
status,
catatan,
menit_lembur,
seq,
jam_mulai_real,
jam_akhir_real,
entry_date,
nama_panggilan,
mac_computer,
approve_date,
approve_user,
approve_mac_komoputer,
approve_hrd,
status_hrdapprove,
approvedate_hrd,
keterangans,
approve_spv,
approve_spv_date
FROM t_lembur_pegawai
WHERE (approve_user = ':session.UserID')
ORDER BY tgl DESC
</m_strSQL>
