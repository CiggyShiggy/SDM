tgl_akhir,
CONCAT(TIMESTAMPDIFF( YEAR, NOW(), tgl_akhir ),' Tahun ',
TIMESTAMPDIFF( MONTH, NOW(), tgl_akhir ) % 12,' Bulan ',
FLOOR( TIMESTAMPDIFF( DAY, NOW(), tgl_akhir) % 30.4375 ),' Hari') AS kurang,
DATEDIFF(tgl_akhir,NOW()) as hari</m_sqlHead>
			<m_sqlFrom>FROM t_mou_vendor</m_sqlFrom>
			<m_sqlWhere>(DATEDIFF(tgl_akhir,NOW()) &lt;= 60) and (DATEDIFF(tgl_akhir,NOW()) &gt;= -15)</m_sqlWhere>
