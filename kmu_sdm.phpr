					<m_strEventCode>$values['id_pegawai'];
$values['nama_panggilan'];
$sql = CustomQuery("SELECT p.`jam_mulai`,p.`jam_selesai`, p.tgl FROM absensi.t_lembur_pegawai p WHERE p.`id_pegawai` = '".$values['id_pegawai']."' AND p.tgl = '".$values['tgl']."'");
$result = db_fetch_array($sql);
$values['jam_mulai_real']=$result['jam_mulai'];
$values['jam_akhir_real']=$result['jam_selesai'];
$values['approve_date'] = now();


// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
