			</DiagramCoordinates>
			<m_arrOrderIndexes />
			<m_strSQL>SELECT c.id_pegawai,p.nama_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah  FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE k.kode_jc = 'CT' AND YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai
LEFT JOIN kmu_sdm.m_pegawai p ON p.id_pegawai = c.id_pegawai WHERE p.aktif = 'Y'
	</m_strSQL>
			<m_sqlHead>SELECT c.id_pegawai,p.nama_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah</m_sqlHead>
			<m_sqlFrom>FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE k.kode_jc = 'CT' AND YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai
LEFT JOIN kmu_sdm.m_pegawai p ON p.id_pegawai = c.id_pegawai</m_sqlFrom>
			<m_sqlWhere>p.aktif = 'Y'</m_sqlWhere>
			<m_sqlTail></m_sqlTail>
