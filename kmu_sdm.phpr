				</v>
				<v>
					<m_isRunTime>0</m_isRunTime>
					<m_strPage>Add page</m_strPage>
					<m_strName>EVENT_PROCESSVALUES_ADD</m_strName>
					<m_strEventCode>//NIP Otomatis
$tanggal = date('Y.m.d',strtotime($values['tgl_masuk']));

if($values['jns_kel']='L')
{$jns = '01';}
else
{$jns = '02';};

$rs = CustomQuery("SELECT MAX(CAST(RIGHT(id_pegawai,3) AS INT)) AS id_pegawai FROM m_pegawai");
$record = db_fetch_array($rs);
$nilai = sprintf('%03d',intval($record['id_pegawai']) + 1);

$values['id_pegawai'] = $tanggal.'.'.$jns.'.'.$nilai;

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
					<m_strEventID>EVENT_PROCESSVALUES_ADD</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
