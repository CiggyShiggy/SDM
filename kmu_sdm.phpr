				<m_arrOrderIndexes />
				<m_strSQL>SELECT DISTINCT
sisa_cuti.id_pegawai,
t_cuti_pegawai.entry_user,
t_jenis_cuti.deskripsi,
sisa_cuti.sisa_ct,
year(t_cuti_pegawai.tgl_mulai) as Tahun
FROM sisa_cuti
LEFT OUTER JOIN t_cuti_pegawai ON t_cuti_pegawai.id_pegawai = sisa_cuti.id_pegawai
LEFT OUTER JOIN t_jenis_cuti ON t_cuti_pegawai.kode_jc = t_jenis_cuti.kode
WHERE (t_cuti_pegawai.entry_user = ':session.UserID') AND YEAR(t_cuti_pegawai.tgl_mulai) = YEAR(NOW());
</m_strSQL>
				<m_sqlHead>SELECT DISTINCT sisa_cuti.id_pegawai,
t_cuti_pegawai.entry_user,
t_jenis_cuti.deskripsi,
sisa_cuti.sisa_ct,
year(t_cuti_pegawai.tgl_mulai) as Tahun</m_sqlHead>
				<m_sqlFrom>FROM sisa_cuti
LEFT OUTER JOIN t_cuti_pegawai ON t_cuti_pegawai.id_pegawai = sisa_cuti.id_pegawai
LEFT OUTER JOIN t_jenis_cuti ON t_cuti_pegawai.kode_jc = t_jenis_cuti.kode</m_sqlFrom>
				<m_sqlWhere>(t_cuti_pegawai.entry_user = ':session.UserID') AND YEAR(t_cuti_pegawai.tgl_mulai) = YEAR(NOW())</m_sqlWhere>
