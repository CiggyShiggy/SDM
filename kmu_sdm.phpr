				<m_arrOrderIndexes />
				<m_strSQL>
SELECT
c.kode
FROM m_pegawai AS p
LEFT OUTER JOIN m_cabang AS c ON p.id_cabang = c.id
WHERE (p.nama_panggilan = "':session.userID'")
</m_strSQL>
				<m_sqlHead>
SELECT c.kode</m_sqlHead>
				<m_sqlFrom>FROM m_pegawai AS p
LEFT OUTER JOIN m_cabang AS c ON p.id_cabang = c.id</m_sqlFrom>
				<m_sqlWhere>(p.nama_panggilan = "':session.userID'")</m_sqlWhere>
