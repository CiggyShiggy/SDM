					<m_strOrderField>DATEDIFF(tgl_akhir, NOW())</m_strOrderField>
				</v>
			</m_arrOrderIndexes>
			<m_strSQL>SELECT
no_surat,
id_pegawai,
tgl_awal,
tgl_akhir,
if(DATEDIFF(tgl_akhir,NOW())&gt;0,
CONCAT("Kurang ",DATEDIFF(tgl_akhir,NOW())," Hari"),
CONCAT("Lewat ",DATEDIFF(tgl_akhir,NOW())*-1," Hari")) as hari,
DATEDIFF(tgl_akhir,NOW()) as kurang
FROM t_kontrak_kerja
WHERE (DATEDIFF(tgl_akhir,NOW()) &lt;= 30) AND (DATEDIFF(tgl_akhir,NOW()) &gt;= -15)
ORDER BY kurang DESC
</m_strSQL>
			<m_sqlHead>SELECT no_surat,
id_pegawai,
tgl_awal,
tgl_akhir,
if(DATEDIFF(tgl_akhir,NOW())&gt;0,
CONCAT("Kurang ",DATEDIFF(tgl_akhir,NOW())," Hari"),
CONCAT("Lewat ",DATEDIFF(tgl_akhir,NOW())*-1," Hari")) as hari,
DATEDIFF(tgl_akhir,NOW()) as kurang</m_sqlHead>
			<m_sqlFrom>FROM t_kontrak_kerja</m_sqlFrom>
			<m_sqlWhere>(DATEDIFF(tgl_akhir,NOW()) &lt;= 30) AND (DATEDIFF(tgl_akhir,NOW()) &gt;= -15)</m_sqlWhere>
