			<query>
				<m_sql>SELECT
id_pegawai,
nama_pegawai,
tgl_lahir,
tgl_masuk,
YEAR(CURDATE()) - YEAR(tgl_lahir) - IF(STR_TO_DATE(CONCAT(YEAR(CURDATE()), '-', MONTH(tgl_lahir), '-', DAY(tgl_lahir)) ,'%Y-%c-%e') &gt; CURDATE(), 1, 0) AS usia,
YEAR(CURDATE()) - YEAR(tgl_masuk) - IF(STR_TO_DATE(CONCAT(YEAR(CURDATE()), '-', MONTH(tgl_masuk), '-', DAY(tgl_masuk)) ,'%Y-%c-%e') &gt; CURDATE(), 1, 0) AS masa_kerja
FROM m_pegawai
WHERE (aktif = "Y")
</m_sql>
