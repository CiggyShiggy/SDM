approve_user,
approve_mac_komoputer,
approve_hrd,
status_hrdapprove,
approvedate_hrd,
keterangans,
approve_spv,
approve_spv_date
FROM t_lembur_pegawai
WHERE (approve_user = ':session.UserID')
ORDER BY tgl DESC</m_strSQL>
