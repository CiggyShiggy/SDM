			<query>
				<m_sql>SELECT
i.id_pegawai,
i.tgl,
i.nama_panggilan,
i.menit_lembur,
c.cabang,
i.jam_mulai,
i.jam_selesai,
i.jam_mulai_real,
i.jam_akhir_real,
i.ket,
i.status,
i.approve_date,
i.approve_user,
i.approve_spv_date,
i.approve_spv,
i.approvedate_hrd,
i.approve_hrd
FROM t_lembur_pegawai AS i
LEFT OUTER JOIN kmu_sdm.m_pegawai AS p ON i.id_pegawai = p.id_pegawai
LEFT OUTER JOIN kmu_sdm.m_cabang AS c ON p.id_cabang = c.id ORDER BY i.tgl DESC
</m_sql>
