			<query>
				<m_sql>SELECT
w.id_pegawai,
a.Badgenumber,
p.nama_panggilan,
u.id_manajer,
u.nama_manager,
u.nm_unit

FROM absensi.userinfo AS a
LEFT JOIN kmu_sdm.m_userinfo_pegawai AS w ON a.Badgenumber = w.Badgenumber
LEFT JOIN kmu_sdm.m_pegawai AS p ON w.id_pegawai = p.id_pegawai
LEFT JOIN (SELECT k.`id_unit`,k.id_manajer,p.nama_pegawai AS nama_manager,k.nm_unit FROM `m_unit_kerja` k LEFT JOIN  m_pegawai p ON k.id_manajer = p.id_pegawai WHERE IFNULL(k.isaktif,0)=1) AS u
ON u.id_unit = p.`id_unit`
WHERE (a.Badgenumber = w.Badgenumber) AND (p.nama_panggilan = ':session.UserID') AND (p.id_pegawai = w.id_pegawai)
</m_sql>
				<m_parsed>1</m_parsed>
				<type>SQL::Query</type>
				<m_strHead>SELECT</m_strHead>
				<m_strFieldList>w.id_pegawai,
a.Badgenumber,
p.nama_panggilan,
u.id_manajer,
u.nama_manager,
u.nm_unit</m_strFieldList>
				<m_strFrom>FROM absensi.userinfo AS a
LEFT JOIN kmu_sdm.m_userinfo_pegawai AS w ON a.Badgenumber = w.Badgenumber
LEFT JOIN kmu_sdm.m_pegawai AS p ON w.id_pegawai = p.id_pegawai
LEFT JOIN (SELECT k.`id_unit`,k.id_manajer,p.nama_pegawai AS nama_manager,k.nm_unit FROM `m_unit_kerja` k LEFT JOIN  m_pegawai p ON k.id_manajer = p.id_pegawai WHERE IFNULL(k.isaktif,0)=1) AS u
ON u.id_unit = p.`id_unit`</m_strFrom>
				<m_strWhere>(a.Badgenumber = w.Badgenumber) AND (p.nama_panggilan = ':session.UserID') AND (p.id_pegawai = w.id_pegawai)</m_strWhere>
				<m_strOrderBy></m_strOrderBy>
