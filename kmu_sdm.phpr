				<m_arrOrderIndexes />
				<m_strSQL>SELECT distinct
p.id_pegawai,
w.nik,
a.Name,
p.nama_pegawai
FROM absensi.userinfo AS a
RIGHT OUTER JOIN m_userinfo_pegawai AS w ON w.Badgenumber = a.Badgenumber
RIGHT OUTER JOIN m_pegawai AS p ON p.id_pegawai = w.id_pegawai
WHERE (p.id_pegawai = w.id_pegawai) AND (a.Badgenumber = w.Badgenumber)
</m_strSQL>
				<m_sqlHead>SELECT distinct p.id_pegawai,
w.nik,
a.Name,
p.nama_pegawai</m_sqlHead>
				<m_sqlFrom>FROM absensi.userinfo AS a
RIGHT OUTER JOIN m_userinfo_pegawai AS w ON w.Badgenumber = a.Badgenumber
RIGHT OUTER JOIN m_pegawai AS p ON p.id_pegawai = w.id_pegawai</m_sqlFrom>
				<m_sqlWhere>(p.id_pegawai = w.id_pegawai) AND (a.Badgenumber = w.Badgenumber)</m_sqlWhere>
