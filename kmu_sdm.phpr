//}
if($values['lock_hrd']=='1' &amp;&amp;$values['kode_jc']=='CT'){
	$sql2 = CustomQuery("UPDATE  absensi.t_cuti_pegawai SET  lock_hrd ='1', statuss = 'Permohonan Cuti Tahunan telah di setujui oleh HRD maupun Kep.Div/Manager', data_add='1'  WHERE kode_jc='CT' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");

$cek = CustomQuery("SELECT c.id_pegawai,IFNULL(b.jumlah,0) AS cuti,c.cuti_jatah - IFNULL(b.jumlah,0) AS jumlah  FROM kmu_sdm.m_userinfo_pegawai c 
LEFT JOIN (SELECT k.id_pegawai, COUNT(k.id_pegawai) AS jumlah 
	FROM absensi.cuti_detail k 
	WHERE k.kode_jc='CT' AND YEAR(k.tgl) = YEAR(NOW()) GROUP BY k.`id_pegawai`) b ON c.id_pegawai = b.id_pegawai WHERE b.id_pegawai = '".$values['id_pegawai']."'");
$kue = db_fetch_array($cek);
$skil = CustomQuery("SELECT id_pegawai,sisa_ct FROM absensi.sisa_cuti WHERE id_pegawai = '".$values['id_pegawai']."'");
$kuwe = db_fetch_array($skil);

if(!empty($kuwe['id_pegawai']) || !empty($kuwe['sisa_ct'])){
$sk = CustomQuery("UPDATE absensi.sisa_cuti SET sisa_ct = '".$kue['jumlah']."' WHERE id_pegawai = '".$kue['id_pegawai']."'");
}else{
	$sqli = CustomQuery("INSERT INTO absensi.sisa_cuti(`id_pegawai`, `sisa_ct`) VALUES ('".$kue['id_pegawai']."','".$kue['jumlah']."')");
}
//$sql2 = CustomQuery("UPDATE  absensi.t_cuti_pegawai SET  hak_cuti = '".$values['totalambil']."' WHERE id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
	//$sqli = CustomQuery("UPDATE absensi.cuti_detail SET data_add='1'  WHERE id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='1' &amp;&amp; $values['kode_jc']=='I'){
	$sql2 = CustomQuery("UPDATE  absensi.t_cuti_pegawai SET  lock_hrd ='1', statuss = 'Permohonan Izin telah di setujui oleh HRD maupun Kep.Div/Manager'  WHERE kode_jc='I' AND id_pegawai='".$values['id_pegawai']."' AND tgl_mulai='".$values['tgl_mulai']."' AND date_token = '".$values['date_token']."'");
}
else if($values['lock_hrd']=='1' &amp;&amp; $values['kode_jc']=='S'){
