}
else if($values['lock_mngr']=='0'&amp;&amp; $values['kode_jc']=='CT'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_mngr ='0', statuss = 'permohonan cuti tahunan di tolak oleh Kep.Div/Manager' WHERE kode_jc ='CT' AND id_pegawai='".$values['id_pegawai']."'");

}else if($values['lock_mngr']=='0'&amp;&amp; $values['kode_jc']=='CL'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_mngr ='0', statuss = 'permohonan cuti lainnya di tolak oleh Kep.Div/Manager' WHERE kode_jc ='CL' AND id_pegawai='".$values['id_pegawai']."'");

}else if($values['lock_mngr']=='0'&amp;&amp; $values['kode_jc']=='S'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_mngr ='0', statuss = 'permohonan cuti sakit di tolak oleh Kep.Div/Manager' WHERE kode_jc ='S' AND id_pegawai='".$values['id_pegawai']."'");

}else if($values['lock_mngr']=='0'&amp;&amp; $values['kode_jc']=='I'){
	$sql2 = CustomQuery("UPDATE absensi.t_cuti_pegawai SET  lock_mngr ='0', statuss = 'permohonan cuti izin di tolak oleh Kep.Div/Manager' WHERE kode_jc ='I' AND id_pegawai='".$values['id_pegawai']."'");

}else{
	returnError404();
}

