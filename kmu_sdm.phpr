					<m_strName>EVENT_BEFOREDELETE</m_strName>
					<m_strEventCode>$cek = CustomQuery("SELECT status_approve FROM absensi.t_ajuan_shift WHERE id_pegawai = '".$deleted_values['id_pegawai']."' and nama_panggilan = '".$_SESSION['UserID']."' AND tgl_pindah_shf = '".$deleted_values['tgl_pindah_shf']."'");
$rec = db_fetch_array($cek);
if($rec['status_approve'] == "Ditolak"){
$message = "Maaf data tidak bisa dihapus";
return false;
exit();
}
if($rec['status_approve'] == "Disetujui"){
$message = "Maaf data tidak bisa dihapus";
return false;
exit();
}

// Place event code here.
// Use "Add Action" button to add code snippets.

return true;</m_strEventCode>
