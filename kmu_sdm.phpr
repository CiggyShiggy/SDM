			<query>
				<m_sql>SELECT
m_pegawai.id_pegawai,
m_pegawai.nama_panggilan,
m_pegawai.nama_pegawai,
m_pegawai.jns_kel,
m_pegawai.tgl_lahir,
m_pegawai.agama,
m_pegawai.alamat,
m_pegawai.no_telp,
m_pegawai.email,
m_pegawai.no_ktp,
m_pegawai.tgl_masuk,
m_pegawai.pendidikan,
m_pegawai.prodi,
m_pegawai.status_pgw,
m_pegawai.kategori,
m_pegawai.id_cabang,
m_pegawai.id_unit,
m_pegawai.foto,
m_pegawai.file_ktp,
m_pegawai.sandi,
m_pegawai.keterangan,
m_pegawai.aktif,
m_unit_kerja.id_manajer
FROM m_pegawai
LEFT OUTER JOIN m_unit_kerja ON m_pegawai.id_unit = m_unit_kerja.id_unit
WHERE (m_pegawai.nama_panggilan &lt;&gt;'administrator') AND (m_pegawai.aktif ='Y')
</m_sql>
