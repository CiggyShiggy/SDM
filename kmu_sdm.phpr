					<m_strEventCode>var preViewjamend = Runner.getControl(pageid,'jam_mulai');
var preViewjamreal = Runner.getControl(pageid,'jam_selesai');
var preViewapprove = Runner.getControl(pageid,'id_pegawai');
var preViewtgl = Runner.getControl(pageid,'tgl');
var preViewstatus =  Runner.getControl(pageid,'status');
var preViewket =  Runner.getControl(pageid,'ket');


if(preViewstatus.getValue() == 'DILAKSANAKAN') {
  
preViewjamend.setDisabled();
preViewjamreal.setDisabled();
preViewapprove.setDisabled();
preViewstatus.setDisabled();
preViewtgl.setDisabled();
preViewket.setDisabled();
}

