			<m_sqlFrom>FROM m_pegawai
LEFT OUTER JOIN m_unit_kerja ON m_pegawai.id_unit = m_unit_kerja.id_unit</m_sqlFrom>
			<m_sqlWhere>(m_pegawai.nama_panggilan &lt;&gt;'administrator') AND (m_pegawai.aktif ='Y')</m_sqlWhere>
