					<m_strEventCode>$sql = CustomQuery("SELECT COUNT(d.id_pegawai) AS totalambil FROM absensi.`t_cuti_pegawai` p 
											LEFT JOIN absensi.`cuti_detail` d ON p.date_token = d.date_token 
											WHERE d.id_pegawai =  '".$values['id_pegawai']."' AND d.kode_jc = 'CT'
											AND YEAR(d.tgl)= YEAR(NOW())GROUP BY d.id_pegawai");
$tampung = db_fetch_array($sql);

$values['hak_cuti']='12'-$tampung['totalambil'];
$values['approve_datehr']=now();
$sql2 = CustomQuery("SELECT p.`nama_panggilan` FROM `t_level_pegawai` l LEFT JOIN m_pegawai p ON l.`id_manager` = p.`id_pegawai` WHERE p.`nama_panggilan` = '".$_SESSION['UserID']."'");
$record1 = db_fetch_array($sql2);
$values['approve_hrd'] = $record1['nama_panggilan'];


