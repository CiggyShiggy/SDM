					<m_strEventCode>$values['entry_date']=now();
$values['approve_spv']='PENDING';

$cekjam = CustomQuery("SELECT id_pegawai, jam_mulai, jam_selesai,tgl FROM absensi.t_lembur_pegawai WHERE nama_panggilan = '".$_SESSION['UserID']."' AND id_pegawai = '".$values['id_pegawai']."'");
$rec = db_fetch_array($cekjam);

if(($rec['jam_mulai'] == $values['jam_mulai'] &amp;&amp; $rec['tgl'] == $values['tgl'])  || ($rec['tgl'] == $values['tgl'] &amp;&amp; $rec['jam_selesai'] == $values['jam_selesai'])){
$message = "Maaf waktu lembur pada hari tersebut telah anda ambil";
return false;
exit();
}
// Place event code here.
// Use "Add Action" button to add code snippets.

return true;</m_strEventCode>
