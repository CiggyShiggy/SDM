					<m_strName>EVENT_AFTEREDIT</m_strName>
					<m_strEventCode>global $dal;
$tblUsers = $dal-&gt;Table("kmu_sdm.m_user");
$tblUsers-&gt;Param["id_pegawai"]=$values["id_pegawai"];
$tblUsers-&gt;Value["nama_panggilan"]=$values['nama_panggilan'];
$tblUsers-&gt;Value["nama_pegawai"]=$values['nama_pegawai'];
$tblUsers-&gt;Value["email"]=$values['email'];
$tblUsers-&gt;Update();

// Place event code here.
// Use "Add Action" button to add code snippets.

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
					<m_strEventID>EVENT_AFTEREDIT</m_strEventID>
