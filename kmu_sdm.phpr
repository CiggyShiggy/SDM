	<m_controlHandlers>
		<v>
			<m_isRunTime>0</m_isRunTime>
			<m_strPage />
			<m_strName>tgl_event</m_strName>
			<m_strEventCode />
			<m_strEventID>EVENT_FIELD</m_strEventID>
			<m_strWidgetID />
			<sub>
				<v>
					<m_isRunTime>1</m_isRunTime>
					<m_strPage />
					<m_strName>Client Before</m_strName>
					<m_strEventCode>

// Place event code here.
// Use "Add Action" button to add code snippets.
var ctrlnomer = Runner.getControl(pageid,'no_surat');
var ctrlkat_id = Runner.getControl(pageid,'kat_id');
var ctrlinst_id = Runner.getControl(pageid,'instansi_id');
var ctrltgl = Runner.getControl(pageid,'tgl');

// Sample:

params["bulan"] = ctrltgl.getValue().getMonth();
params["tahun"] = ctrltgl.getValue().getFullYear();
params["kat_id"] = ctrlkat_id.getValue();
params["inst_id"] = ctrlinst_id.getValue();

// Uncomment the following line to skip "Server" and "Client After" steps.
// return false;
</m_strEventCode>
					<m_strEventID>EVENT_JS</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
				</v>
				<v>
					<m_isRunTime>0</m_isRunTime>
					<m_strPage />
					<m_strName>Server</m_strName>
					<m_strEventCode>$jml = 0;

// Place event code here.
// Use "Add Action" button to add code snippets.

$kat = DBLookup("SELECT kode_surat FROM m_kategori_surat WHERE kat_id='".$params["kat_id"]."'");
$inst = DBLookup("SELECT kode_surat FROM m_instansi_surat WHERE id='".$params["inst_id"]."'");

function numberToRomanRepresentation($number) {
    $map = array('M' =&gt; 1000, 'CM' =&gt; 900, 'D' =&gt; 500, 'CD' =&gt; 400, 'C' =&gt; 100, 'XC' =&gt; 90, 'L' =&gt; 50, 'XL' =&gt; 40, 'X' =&gt; 10, 'IX' =&gt; 9, 'V' =&gt; 5, 'IV' =&gt; 4, 'I' =&gt; 1);
    $returnValue = '';
    while ($number &gt; 0) {
        foreach ($map as $roman =&gt; $int) {
            if($number &gt;= $int) {
                $number -= $int;
                $returnValue .= $roman;
                break;
            }
        }
    }
    return $returnValue;
};

$bulan = numberToRomanRepresentation(intval($params["bulan"])+1);

$tahun = intval($params["tahun"]);

do {
$jml=$jml+1;
$kode = sprintf('%03d',$jml).'/'.$kat.'/'.$inst.'/'.$bulan.'/'.$tahun;
$rs = CustomQuery("SELECT no_surat FROM t_surat_keluar WHERE no_surat='".$kode."'");
$record = db_fetch_array($rs);
$iskode = $record['no_surat'];
}while($iskode);

// Sample:
$result["upper"] = $kode;
</m_strEventCode>
					<m_strEventID>EVENT_SERVER</m_strEventID>
					<m_strWidgetID />
					<sub />
					<m_caption>
						<text />
						<nameType>Text</nameType>
					</m_caption>
					<m_strDotNetLanguage>cs</m_strDotNetLanguage>
				</v>
				<v>
					<m_isRunTime>1</m_isRunTime>
					<m_strPage />
					<m_strName>Client After</m_strName>
					<m_strEventCode>

// Place event code here.
// Use "Add Action" button to add code snippets.


        
// Smaple:
//this.setValue( result["upper"] );
var ctrlnomer = Runner.getControl(pageid,'no_surat');
ctrlnomer.setValue(result["upper"]); 
//pageObj.displayMessage(result["upper"]);

</m_strEventCode>
					<m_strEventID>EVENT_JS</m_strEventID>
