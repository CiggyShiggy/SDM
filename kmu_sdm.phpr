					<m_strEventCode>if ($data['kurang'] &lt; 30){
	$record["css"].='background:red';
	$row["rowstyle"]='style="color:white"';
} else if ($data['kurang'] &lt; 60){
	$record["css"].='background:#ff7300';
	$row["rowstyle"]='style="color:red"';
}	else if ($data['kurang'] &lt; 90){
	$record["css"].='background:yellow';
	$row["rowstyle"]='style="color:red"';
} else if ($data['kurang'] &lt; 120){
	$record["css"].='background: #f6ff00';
	$row["rowstyle"]='style="color:red"';
}	else if ($data['kurang'] &lt; 150){
	$record["css"].='background: #8aff00';
	$row["rowstyle"]='style="color:black"';
}	else if ($data['kurang'] &lt; 180){
	$record["css"].='background:lime';
	$row["rowstyle"]='style="color:black"';
}	else{
	$record["css"].='background:#white';
	$row["rowstyle"]='style="color:black"';
}


