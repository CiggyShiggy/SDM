			<m_strName>EVENT_INIT_APP</m_strName>
			<m_strEventCode>global $customjscript;
//$dDebug=true;
$customjscript = &lt;&lt;&lt;EOT
&lt;script type="text/javascript"&gt;
              $(window).load(function () {
                        $('head').append('&lt;link href="favicon.ico" rel="shortcut icon" type="image/x-icon" /&gt;');
                        });
&lt;/script&gt;
EOT;

// Place event code here.
// Use "Add Action" button to add code snippets.</m_strEventCode>
			<m_strEventID>EVENT_INIT_APP</m_strEventID>
			<m_strWidgetID />
			<sub />
