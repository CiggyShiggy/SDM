TIMESTAMPDIFF( MONTH, NOW(), tgl_akhir ) % 12,' Bulan ',
FLOOR( TIMESTAMPDIFF( DAY, NOW(), tgl_akhir) % 30.4375 ),' Hari'),
CONCAT('LEWAT ',TIMESTAMPDIFF( YEAR, NOW(), tgl_akhir )*-1,' Tahun ',
TIMESTAMPDIFF( MONTH, NOW(), tgl_akhir )*-1 % 12,' Bulan ',
FLOOR( TIMESTAMPDIFF( DAY, NOW(), tgl_akhir)*-1 % 30.4375 ),' Hari')) AS estimasi,
if(DATEDIFF(tgl_akhir,NOW())&gt;0,
CONCAT("Kurang ",DATEDIFF(tgl_akhir,NOW())," Hari"),
CONCAT("Lewat ",DATEDIFF(tgl_akhir,NOW())*-1," Hari")) as hari,
DATEDIFF(tgl_akhir,NOW()) as kurang</m_strFieldList>
