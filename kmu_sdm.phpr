LEFT OUTER JOIN t_cuti_pegawai ON t_cuti_pegawai.id_pegawai = sisa_cuti.id_pegawai
LEFT OUTER JOIN t_jenis_cuti ON t_cuti_pegawai.kode_jc = t_jenis_cuti.kode</m_strFrom>
					<m_strWhere>(t_cuti_pegawai.entry_user = ':session.UserID') AND YEAR(t_cuti_pegawai.tgl_mulai) = YEAR(NOW())</m_strWhere>
