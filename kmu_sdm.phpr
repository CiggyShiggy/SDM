					<m_strEventCode>
$sql = CustomQuery(" SELECT tgl, TIMESTAMPDIFF(MINUTE,jam_mulai,jam_selesai) as menit FROM absensi.t_lembur_pegawai WHERE id_pegawai = '".$values['id_pegawai']."' AND nama_panggilan = '".$values['nama_panggilan']."'");
$ambildata = db_fetch_array($sql);
$update = CustomQuery("UPDATE absensi.t_lembur_pegawai SET menit_lembur = '".$ambildata['menit']."' WHERE id_pegawai = '".$values['id_pegawai']."' AND nama_panggilan = '".$values['nama_panggilan']."'");


// Place event code here.
