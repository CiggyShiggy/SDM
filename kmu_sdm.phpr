			<DiagramCoordinates>
				<x1>457</x1>
				<x2>612</x2>
				<y1>3590</y1>
				<y2>3790</y2>
			</DiagramCoordinates>
			<m_arrOrderIndexes />
			<m_strSQL>SELECT
w.id_pegawai,
a.Badgenumber,
p.nama_panggilan,
u.id_manajer,
u.nama_manager,
u.nm_unit

FROM absensi.userinfo AS a
LEFT JOIN kmu_sdm.m_userinfo_pegawai AS w ON a.Badgenumber = w.Badgenumber
LEFT JOIN kmu_sdm.m_pegawai AS p ON w.id_pegawai = p.id_pegawai
LEFT JOIN (SELECT k.`id_unit`,k.id_manajer,p.nama_pegawai AS nama_manager,k.nm_unit FROM `m_unit_kerja` k LEFT JOIN  m_pegawai p ON k.id_manajer = p.id_pegawai WHERE IFNULL(k.isaktif,0)=1) AS u
ON u.id_unit = p.`id_unit`
WHERE (a.Badgenumber = w.Badgenumber) AND (p.nama_panggilan = ':session.UserID') AND (p.id_pegawai = w.id_pegawai)
</m_strSQL>
			<m_sqlHead>SELECT w.id_pegawai,
a.Badgenumber,
p.nama_panggilan,
u.id_manajer,
u.nama_manager,
u.nm_unit</m_sqlHead>
			<m_sqlFrom>FROM absensi.userinfo AS a
LEFT JOIN kmu_sdm.m_userinfo_pegawai AS w ON a.Badgenumber = w.Badgenumber
LEFT JOIN kmu_sdm.m_pegawai AS p ON w.id_pegawai = p.id_pegawai
LEFT JOIN (SELECT k.`id_unit`,k.id_manajer,p.nama_pegawai AS nama_manager,k.nm_unit FROM `m_unit_kerja` k LEFT JOIN  m_pegawai p ON k.id_manajer = p.id_pegawai WHERE IFNULL(k.isaktif,0)=1) AS u
ON u.id_unit = p.`id_unit`</m_sqlFrom>
			<m_sqlWhere>(a.Badgenumber = w.Badgenumber) AND (p.nama_panggilan = ':session.UserID') AND (p.id_pegawai = w.id_pegawai)</m_sqlWhere>
